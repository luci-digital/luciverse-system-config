add_rules("mode.release")

-- Output directory base
local out_dir = "dist/bin"

-- common files
local common_files = {
    "src/c/dispatch.c",
    "src/c/main.c",
}

target("luciverse_scalar")
    set_kind("binary")
    add_files(table.join2(common_files, {"src/c/compute_scalar.c"}))
    set_targetdir(path.join(out_dir, "scalar"))

target("luciverse_avx2")
    set_kind("binary")
    add_files(table.join2(common_files, {"src/c/compute_avx2.c"}))
    add_cxflags("-mavx2", "-mbmi2", "-mfma", "-O3")
    set_targetdir(path.join(out_dir, "avx2"))

target("luciverse_avx512")
    set_kind("binary")
    add_files(table.join2(common_files, {"src/c/compute_avx512.c"}))
    add_cxflags("-mavx512f", "-mavx512bw", "-mavx512dq", "-O3")
    set_targetdir(path.join(out_dir, "avx512"))
