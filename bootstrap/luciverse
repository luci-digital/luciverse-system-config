    def check_port(self, ip: str, port: int, timeout: float = 0.5) -> bool:
        """Check if a port is open"""
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.settimeout(timeout)
            result = sock.connect_ex((ip, port))
            sock.close()
            return result == 0
        except:
            return False

    def discover_idrac(self):
        """Discover iDRAC/BMC connections on network"""
        print("[1/5] 🔍 Discovering iDRAC/BMC connections...")

        def scan_host(ip):
            results = []
            for port in IDRAC_PORTS:
                if self.check_port(ip, port):
                    results.append({"ip": ip, "port": port})
            return results

        found = []
        for range_cidr in IDRAC_SCAN_RANGES:
            try:
                network = ipaddress.ip_network(range_cidr, strict=False)
                # Only scan .1-.254 for speed
                hosts = [str(ip) for ip in list(network.hosts())[:254]]

                print(f"      Scanning {range_cidr}...", end=" ", flush=True)

                with ThreadPoolExecutor(max_workers=50) as executor:
                    futures = {executor.submit(scan_host, ip): ip for ip in hosts}
                    for future in as_completed(futures, timeout=30):
                        try:
                            results = future.result()
                            if results:
                                found.extend(results)
                        except:
                            pass

                print(f"found {len([f for f in found if f['ip'].startswith(range_cidr.split('/')[0][:8])])} hosts")
            except Exception as e:
                print(f"error: {e}")

        # Check known iDRAC
        known_idrac = [
            ("192.168.1.182", "R630-JMRZDB2"),
            ("192.168.1.141", "R730-ORION"),
        ]

        for ip, name in known_idrac:
            for port in IDRAC_PORTS:
                if self.check_port(ip, port, timeout=1):
                    entry = {"ip": ip, "port": port, "name": name}
                    if entry not in found:
                        found.append(entry)
                    print(f"      ✓ {name}: {ip}:{port}")

        self.discovered["idrac"] = found
        print(f"      Total iDRAC endpoints: {len(found)}")
        return found

