#!ipxe

set base-url http://192.168.1.145:8000/bootimus

menu LuciVerse Bootimus
item --gap -- -------- Onboarding --------
item iso Download the onboarding ISO
item shell Drop to the iPXE shell
choose --default iso --timeout 5000 target && goto ${target}

:iso
echo LuciVerse onboarding artifacts are published at ${base-url}/
echo Boot the ISO from your operator console or fetch it with curl.
sleep 2
goto shell

:shell
shell
